{
  "compilerOptions":{
    "target": "es2024",

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "types": ["node"],

    "esModuleInterop": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true

  },

  "include":[
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],

  "exclude":[
    "node_modules",
    "dist"
  ]
}